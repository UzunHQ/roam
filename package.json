{
  "name": "roam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/pack-campus.mjs && vite",
    "dev:phone": "vite --host",
    "build": "node scripts/pack-campus.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host",
    "build:campus": "node scripts/build-campus.mjs && node scripts/build-context.mjs --cache && node scripts/slim-geojson.mjs",
    "build:context": "node scripts/build-context.mjs && node scripts/slim-geojson.mjs",
    "build:paths": "node scripts/build-paths.mjs",
    "paths:osm-diff": "node scripts/osm-path-diff.mjs",
    "build:walls": "node scripts/build-walls.mjs",
    "icons": "node scripts/make-icons.mjs",
    "photos": "node scripts/make-photos.mjs",
    "check:hours": "node scripts/check-hours.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:gps": "node scripts/check-gps.mjs",
    "check:paths": "node scripts/check-paths.mjs",
    "gps:report": "node scripts/gps-report.mjs",
    "test:smoke": "node scripts/smoke.mjs http://localhost:5173"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
